{
  "name": "@tcg/api",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "NestJS single process: REST API, PWA static serving, worker queue, Limitless scheduler and MCP endpoint.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "owner:init": "nest build && node dist/cli/owner-init.js",
    "catalog:sync": "nest build && node dist/cli/catalog-sync.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tcg/domain": "workspace:*",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.5.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.1.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "3.6.4",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
