// Phase 1 schema (docs/PLAN.md §4.2). Table and column names are snake_case through @@map/@map.
// Identity of a card is its tracker `card_id`; `internal_id` is a versioned attribute (invariant I1).
// The datasource URL is configured in prisma.config.ts (Prisma 7).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
  previewFeatures        = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, unaccent]
}

// ---------------------------------------------------------------------------------------------------------------
// Catalog (versioned by tracker commit + engine rev)
// ---------------------------------------------------------------------------------------------------------------

enum CatalogSyncStatus {
  running
  applied
  failed
  needs_review

  @@map("catalog_sync_status")
}

enum CatalogSyncSource {
  github
  fixtures

  @@map("catalog_sync_source")
}

model CatalogSync {
  id           Int                 @id @default(autoincrement())
  commitSha    String              @map("commit_sha")
  engineRev    String              @map("engine_rev")
  source       CatalogSyncSource
  status       CatalogSyncStatus
  fetchedAt    DateTime            @map("fetched_at") @db.Timestamptz(3)
  appliedAt    DateTime?           @map("applied_at") @db.Timestamptz(3)
  /// sha256 per fetched file, keyed by source path.
  fileHashes   Json                @map("file_hashes")
  counts       Json
  /// BuildReport from @tcg/domain plus the diff summary against the previous catalog.
  report       Json?
  /// Tracker craftingCost (pack points per rarity) as parsed from CardsDB.ts.
  craftingCost Json?               @map("crafting_cost")
  /// Themed-collection missions of the pinned tracker commit (Fase 8).
  missions     Json?
  error        String?
  changes      CatalogSyncChange[]

  @@index([status, id])
  @@map("catalog_syncs")
}

model CatalogSyncChange {
  id     Int         @id @default(autoincrement())
  syncId Int         @map("sync_id")
  sync   CatalogSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  cardId String      @map("card_id")
  field  String
  old    Json?
  new    Json?

  @@index([syncId])
  @@map("catalog_sync_changes")
}

model Expansion {
  id                  String    @id
  trackerInternalId   Int       @map("tracker_internal_id")
  slug                String
  nameEn              String    @map("name_en")
  nameEs              String    @map("name_es")
  /// Position in catalog order (A1 = 0 …, promos last).
  sortOrder           Int       @map("sort_order")
  isPromo             Boolean   @map("is_promo")
  tradeable           Boolean
  openableTracker     Boolean   @map("openable_tracker")
  cardsPerPack        Int?      @map("cards_per_pack")
  containsShinies     Boolean   @default(false) @map("contains_shinies")
  containsBabies      Boolean   @default(false) @map("contains_babies")
  containsLinkedCards Boolean   @default(false) @map("contains_linked_cards")
  /// Owner overrides (not touched by the sync).
  releaseDate         DateTime? @map("release_date") @db.Date
  opensEra            Boolean?  @map("opens_era")
  packs               Pack[]
  cards               Card[]

  @@map("expansions")
}

model Pack {
  id            String     @id
  expansionId   String     @map("expansion_id")
  expansion     Expansion  @relation(fields: [expansionId], references: [id])
  name          String
  nameEs        String     @map("name_es")
  color         String?
  sortOrder     Int        @map("sort_order")
  /// Owner switch: is this pack still available in the game?
  available     Boolean    @default(true)
  /// Owner switch: sold for a limited time (the Deluxe Mega); its last day, owner's time zone, when known.
  limited       Boolean    @default(false)
  limitedUntil  DateTime?  @map("limited_until") @db.Date
  /// Optional manual pack-points balance.
  pointsBalance Int?       @map("points_balance")
  cards         PackCard[]

  @@index([expansionId])
  @@map("packs")
}

model PackCard {
  packId   String @map("pack_id")
  pack     Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  cardId   String @map("card_id")
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position Int

  @@id([packId, cardId])
  @@index([cardId])
  @@map("pack_cards")
}

model FunctionalGroup {
  id            String                 @id
  displayCardId String                 @map("display_card_id")
  nameEn        String                 @map("name_en")
  nameEs        String                 @map("name_es")
  cardType      String                 @map("card_type")
  rulesHash     String                 @map("rules_hash")
  editionCount  Int                    @map("edition_count")
  sortOrder     Int                    @map("sort_order")
  cards         Card[]
  adjustments   CollectionAdjustment[]

  @@index([nameEn])
  @@map("functional_groups")
}

model Card {
  id                   String           @id
  expansionId          String           @map("expansion_id")
  expansion            Expansion        @relation(fields: [expansionId], references: [id])
  number               Int
  internalId           Int              @map("internal_id")
  stockCardId          String           @map("stock_card_id")
  functionalGroupId    String           @map("functional_group_id")
  functionalGroup      FunctionalGroup  @relation(fields: [functionalGroupId], references: [id])
  isDisplayEdition     Boolean          @map("is_display_edition")
  nameEn               String           @map("name_en")
  nameEs               String           @map("name_es")
  nameEsSource         String           @map("name_es_source")
  hp                   Int?
  energy               String
  cardType             String           @map("card_type")
  evolutionType        String           @map("evolution_type")
  evolvesFrom          String?          @map("evolves_from")
  isFossil             Boolean          @map("is_fossil")
  ex                   Boolean
  prizePoints          Int              @map("prize_points")
  baby                 Boolean
  rarity               String
  pack                 String
  artist               String
  attacks              Json
  ability              Json?
  weakness             String?
  retreat              Int?
  imageUrl             String           @map("image_url")
  engineId             String           @map("engine_id")
  searchText           String           @map("search_text")
  alternateVersionsRaw Int[]            @map("alternate_versions_raw")
  /// Position in catalog order (cards.json order).
  sortOrder            Int              @map("sort_order")
  packs                PackCard[]
  stock                CollectionStock?
  deckCards            DeckCard[]

  @@index([internalId])
  @@index([stockCardId])
  @@index([functionalGroupId])
  @@index([nameEn])
  @@index([engineId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("cards")
}

/// Printed evolution exceptions (Eevee ex counts as Eevee for "evolves from Eevee").
model EvolutionAlias {
  cardId   String @id @map("card_id")
  countsAs String @map("counts_as")

  @@map("evolution_aliases")
}

model RarityRule {
  rarity         String  @id
  points         Int?
  pointsVerified Boolean @default(false) @map("points_verified")
  tradeable      Boolean

  @@map("rarity_rules")
}

// ---------------------------------------------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------------------------------------------

enum CollectionImportStatus {
  pending
  applied
  discarded

  @@map("collection_import_status")
}

model CollectionImport {
  source      String                 @default("csv")
  id          Int                    @id @default(autoincrement())
  fileName    String                 @map("file_name")
  sha256      String
  importedAt  DateTime               @default(now()) @map("imported_at") @db.Timestamptz(3)
  appliedAt   DateTime?              @map("applied_at") @db.Timestamptz(3)
  status      CollectionImportStatus @default(pending)
  rowCount    Int                    @map("row_count")
  naiveTotal  Int                    @map("naive_total")
  dedupTotal  Int                    @map("dedup_total")
  unknownIds  String[]               @map("unknown_ids")
  diffSummary Json?                  @map("diff_summary")
  rawFileGz   Bytes                  @map("raw_file_gz")
  rows        CollectionImportRow[]

  @@map("collection_imports")
}

model CollectionImportRow {
  importId    Int              @map("import_id")
  import      CollectionImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Tracker card id as written in the CSV (may be unknown to the catalog: no foreign key).
  cardId      String           @map("card_id")
  internalId  Int              @map("internal_id")
  numberOwned Int              @map("number_owned")
  collected   Boolean

  @@id([importId, cardId])
  @@map("collection_import_rows")
}

enum CollectionStockSource {
  import
  manual
  tracker

  @@map("collection_stock_source")
}

/// One row per stock unit: card_id is the earliest edition of the unit (cards.stock_card_id).
model CollectionStock {
  cardId      String                @id @map("card_id")
  card        Card                  @relation(fields: [cardId], references: [id])
  /// CHECK (amount_owned >= 0) added in the migration.
  amountOwned Int                   @map("amount_owned")
  collected   Boolean               @default(false)
  source      CollectionStockSource
  importId    Int?                  @map("import_id")
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("collection_stock")
}

enum AdjustmentResolution {
  user
  csv_matches
  manual_edit
  converted
  catalog_change

  @@map("adjustment_resolution")
}

/// Absolute playable-copies override per functional group; at most one active per group (partial unique index).
model CollectionAdjustment {
  id                Int                   @id @default(autoincrement())
  functionalGroupId String                @map("functional_group_id")
  functionalGroup   FunctionalGroup       @relation(fields: [functionalGroupId], references: [id])
  playableCopies    Int                   @map("playable_copies")
  reason            String                @default("")
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt        DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolution        AdjustmentResolution?

  @@index([functionalGroupId])
  @@map("collection_adjustments")
}

// ---------------------------------------------------------------------------------------------------------------
// Decks
// ---------------------------------------------------------------------------------------------------------------

enum DeckSource {
  ui
  import
  mcp
  duplicate
  restore

  @@map("deck_source")
}

model Deck {
  id                    Int            @id @default(autoincrement())
  name                  String
  energies              String[]
  tags                  String[]
  notes                 String         @default("")
  builtInGame           Boolean        @default(false) @map("built_in_game")
  builtInGameSince      DateTime?      @map("built_in_game_since") @db.Timestamptz(3)
  variantOfId           Int?           @map("variant_of_id")
  variantOf             Deck?          @relation("DeckVariants", fields: [variantOfId], references: [id], onDelete: SetNull)
  variants              Deck[]         @relation("DeckVariants")
  packPriority          Int            @default(0) @map("pack_priority")
  /// Limitless archetype chosen by the owner for the «torneo» column (null = guessed from the closest lists).
  tournamentArchetypeId String?        @map("tournament_archetype_id")
  /// [{ functionalGroupId, role: attacker | setup }]
  keyCards              Json           @default("[]") @map("key_cards")
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz(3)
  currentRevisionId     Int?           @map("current_revision_id")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  revisions             DeckRevision[]
  changes               DeckChange[]
  cards                 DeckCard[]
  matches               Match[]

  @@index([archivedAt])
  @@map("decks")
}

model DeckRevision {
  id        Int        @id @default(autoincrement())
  deckId    Int        @map("deck_id")
  deck      Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  number    Int
  /// [{ cardId, count }] in list order.
  cards     Json
  energies  String[]
  note      String     @default("")
  source    DeckSource
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  matches   Match[]

  @@unique([deckId, number])
  @@map("deck_revisions")
}

model DeckChange {
  id     Int        @id @default(autoincrement())
  deckId Int        @map("deck_id")
  deck   Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  field  String
  old    Json?
  new    Json?
  at     DateTime   @default(now()) @db.Timestamptz(3)
  source DeckSource

  @@index([deckId, at])
  @@map("deck_changes")
}

/// Materialization of the current revision ("which decks use X").
model DeckCard {
  deckId   Int    @map("deck_id")
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   String @map("card_id")
  card     Card   @relation(fields: [cardId], references: [id])
  count    Int
  position Int

  @@id([deckId, cardId])
  @@index([cardId])
  @@map("deck_cards")
}

// ---------------------------------------------------------------------------------------------------------------
// Matches (Fase 2, M6)
// ---------------------------------------------------------------------------------------------------------------

enum MatchResult {
  win
  loss
  tie

  @@map("match_result")
}

enum MatchMode {
  competitive
  casual
  beginner
  event
  friend

  @@map("match_mode")
}

enum MatchSource {
  ui
  mcp

  @@map("match_source")
}

/// One own match. A deck with matches cannot be deleted (Restrict): it stays archived and in the statistics.
model Match {
  id             Int          @id @default(autoincrement())
  deckId         Int          @map("deck_id")
  deck           Deck         @relation(fields: [deckId], references: [id], onDelete: Restrict)
  /// Revision current when the match was played (domain `revisionAt`).
  deckRevisionId Int          @map("deck_revision_id")
  deckRevision   DeckRevision @relation(fields: [deckRevisionId], references: [id], onDelete: Restrict)
  result         MatchResult
  /// Opponent archetype as typed (cleaned); statistics group it by the domain `opponentKey`. Fase 5 adds archetypes.
  opponentText   String?      @map("opponent_text")
  wentFirst      Boolean?     @map("went_first")
  mode           MatchMode
  note           String       @default("")
  playedAt       DateTime     @default(now()) @map("played_at") @db.Timestamptz(3)
  source         MatchSource  @default(ui)
  /// Fase 28: the phone's id of a match saved without signal (a retry stores it once).
  clientRef      String?      @unique @map("client_ref")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([deckId, playedAt])
  @@index([playedAt])
  @@index([deckRevisionId])
  @@map("matches")
}

// ---------------------------------------------------------------------------------------------------------------
// Access and configuration
// ---------------------------------------------------------------------------------------------------------------

/// Exactly one row (id = 1). Created by `pnpm -F @tcg/api owner:init`.
model Owner {
  id            Int      @id @default(1)
  email         String   @unique
  passwordHash  String   @map("password_hash")
  /// TOTP secret encrypted with AES-256-GCM under a key derived from SESSION_SECRET; null = TOTP disabled.
  totpSecretEnc String?  @map("totp_secret_enc")
  /// Last TOTP time step (epoch / 30 s) accepted at login; codes up to this step are refused (replay protection).
  totpLastStep  Int?     @map("totp_last_step")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("owner")
}

/// Browser sessions: the cookie holds the random id, the table stores its SHA-256.
model Session {
  idHash     String   @id @map("id_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")

  @@index([expiresAt])
  @@map("sessions")
}

enum ApiTokenKind {
  worker
  mcp

  @@map("api_token_kind")
}

model ApiToken {
  id         Int          @id @default(autoincrement())
  name       String
  kind       ApiTokenKind
  scopes     String[]
  tokenHash  String       @unique @map("token_hash")
  /// First characters of the token, for display (tcg_wk_AbCd…).
  prefix     String
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)

  @@map("api_tokens")
}

/// Fase 43 (R-010): one write made by Claude through the MCP. `undo` keeps what is needed to revert it (the deleted
/// match, the collection row before the edit); `undoneAt` marks it reverted. Operational log: not in the backup.
model McpAudit {
  id        Int       @id @default(autoincrement())
  at        DateTime  @default(now()) @db.Timestamptz(3)
  /// The api_tokens id (no foreign key: a log outlives the token and a backup restore).
  tokenId   Int?      @map("token_id")
  tokenName String    @map("token_name")
  /// Product of the client's User-Agent («Claude-User», «python-httpx»…).
  client    String    @default("")
  tool      String
  /// The arguments, long texts cut.
  args      Json
  ok        Boolean
  /// The tool's answer (cut when long); null when it failed.
  result    Json?
  error     String?
  ms        Int
  undo      Json?
  undoneAt  DateTime? @map("undone_at") @db.Timestamptz(3)

  @@index([at])
  @@index([tokenId, at])
  @@map("mcp_audit")
}

/// Fase 43 (R-010): a client seen with a token, and when it was first seen (a new one raises an alert).
model ApiTokenClient {
  tokenId     Int      @map("token_id")
  client      String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  @@id([tokenId, client])
  @@index([firstSeenAt])
  @@map("api_token_clients")
}

/// D-021: a message of the chat between the Claude sessions that work on the app's code: the bridge between the chat
/// file on Santi's PC and the cloud sessions (they reach it only through the MCP). Not Santi's data: not in the backup.
model SessionChatMessage {
  id       Int               @id @default(autoincrement())
  at       DateTime          @default(now()) @db.Timestamptz(3)
  fromName String            @map("from_name")
  /// `chatKey` of the sender: its name in the list, in lower case.
  fromKey  String            @map("from_key")
  toNames  String[]          @map("to_names")
  /// `chatKey` of each recipient (lower case); «todos» reaches everyone.
  toKeys   String[]          @map("to_keys")
  topic    String
  body     String
  tokenId  Int?              @map("token_id")
  /// How it arrived: the API token's name.
  via      String            @default("")
  /// The bridge's own id for a message copied from the PC chat (sending it again does not duplicate it).
  relayRef String?           @unique @map("relay_ref")
  /// Its room (`CHAT_ROOMS`): «tcg», or «posta» (13/10/2026).
  room     String            @default("tcg")
  seen     SessionChatSeen[]

  @@index([at])
  @@index([room, id])
  @@index([toKeys], type: Gin)
  @@map("session_chat_messages")
}

/// D-021: a chat message a participant (by its `chatKey`) has already read. A set, not a watermark: ids can commit
/// out of order with concurrent writers.
model SessionChatSeen {
  participant String
  messageId   Int                @map("message_id")
  message     SessionChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  at          DateTime           @default(now()) @db.Timestamptz(3)

  @@id([participant, messageId])
  @@index([messageId])
  @@map("session_chat_seen")
}

/// D-021: where a chat participant writes from (Santi: his session or the bridge; the PC: the bridge; the cloud: the MCP).
enum SessionChatChannel {
  owner
  relay
  connector

  @@map("session_chat_channel")
}

/// D-021: who takes part in the session chat. `from`, `to` and `as` must be one of these names exactly; only the case
/// does not matter (`key` is the name in lower case).
model SessionChatParticipant {
  key       String             @id
  name      String
  channel   SessionChatChannel
  /// A participant added later starts after this message: what came before counts as read.
  sinceId   Int                @default(0) @map("since_id")
  /// Its rooms, the main one first (an MCP call without «sala» goes there); Santi is in all of them.
  rooms     String[]           @default(["tcg"])
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("session_chat_participants")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model BackupBlob {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  sizeBytes Int      @map("size_bytes")
  dataGz    Bytes    @map("data_gz")

  @@map("backup_blobs")
}

// ---------------------------------------------------------------------------------------------------------------
// Torneos (Fase 5, M5): Limitless data as it came plus the owner's era table and archetype merges
// ---------------------------------------------------------------------------------------------------------------

enum TournamentFormat {
  STANDARD
  NOEX
  EXCLUDED
}

enum TournamentStatus {
  listed
  complete
  incomplete
  excluded
  failed
}

model Tournament {
  id                String              @id
  name              String
  date              DateTime            @db.Timestamptz(3)
  /// `format` as Limitless sent it: null = Standard.
  formatRaw         String?             @map("format_raw")
  format            TournamentFormat
  players           Int
  organizerId       Int?                @map("organizer_id")
  organizerName     String?             @map("organizer_name")
  /// { decklists, isOnline, phases, bannedCards, specialRules } from /details.
  details           Json?
  status            TournamentStatus    @default(listed)
  excludedReason    String?             @map("excluded_reason")
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  lastError         String?             @map("last_error")
  /// The standings JSON, gzipped (kept to re-normalize without calling Limitless again).
  rawStandingsGz    Bytes?              @map("raw_standings_gz")
  standingsSha256   String?             @map("standings_sha256")
  firstSeenAt       DateTime            @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  fetchedAt         DateTime?           @map("fetched_at") @db.Timestamptz(3)
  /// Fase 9: when the pairings were downloaded (null = not yet) and how many tries failed.
  pairingsFetchedAt DateTime?           @map("pairings_fetched_at") @db.Timestamptz(3)
  pairingsAttempts  Int                 @default(0) @map("pairings_attempts")
  entries           TournamentEntry[]
  pairings          TournamentPairing[]

  @@index([date])
  @@index([status, date])
  @@map("tournaments")
}

model TournamentEntry {
  id             Int        @id @default(autoincrement())
  tournamentId   String     @map("tournament_id")
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId       String     @map("player_id")
  playerName     String     @map("player_name")
  country        String?
  placing        Int?
  drop           Int?
  wins           Int
  losses         Int
  ties           Int
  archetypeId    String?    @map("archetype_id")
  archetypeName  String?    @map("archetype_name")
  archetypeIcons String[]   @map("archetype_icons")
  energies       String[]
  /// { pokemon, trainer } as Limitless sent it; null = no list published.
  decklist       Json?

  @@unique([tournamentId, playerId])
  @@index([archetypeId])
  @@map("tournament_entries")
}

/// Who played whom in each round (Fase 9, `/tournaments/{id}/pairings`): the matchups between archetypes.
model TournamentPairing {
  id           Int        @id @default(autoincrement())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  phase        Int
  round        Int
  player1      String
  /// Null: a bye or a no-show.
  player2      String?
  /// p1 | p2 | tie | double_loss | bye
  result       String

  @@index([tournamentId])
  @@map("tournament_pairings")
}

/// Era table (PLAN Apéndice A.5): seeded with the known releases, edited by the owner when a set comes out.
model SetRelease {
  code        String   @id
  nameEn      String   @map("name_en")
  releaseDate DateTime @map("release_date") @db.Date
  opensEra    Boolean  @map("opens_era")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("set_releases")
}

/// Owner's merges of Limitless archetypes (their slugs change): `archetypeId` is shown as `canonicalId`.
model ArchetypeAlias {
  archetypeId String   @id @map("archetype_id")
  canonicalId String   @map("canonical_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("archetype_aliases")
}

model LimitlessSyncRun {
  id                Int       @id @default(autoincrement())
  /// incremental | backfill
  kind              String
  /// running | done | failed | interrupted
  status            String
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(3)
  calls             Int       @default(0)
  tournamentsListed Int       @default(0) @map("tournaments_listed")
  tournamentsDone   Int       @default(0) @map("tournaments_done")
  waitedMs          Int       @default(0) @map("waited_ms")
  error             String?

  @@index([startedAt])
  @@map("limitless_sync_runs")
}

// ---------------------------------------------------------------------------------------------------------------
// Simulación (Fase 6, M7): jobs split into chunks that the worker on the owner's PC claims, plays and reports
// ---------------------------------------------------------------------------------------------------------------

enum SimulationKind {
  matrix
  compare
  optimize
  /// Laboratorio de mazos (T-008): rounds of variants against the meta bank, queued by the API round by round.
  explore
  /// Fase 8: how soon a deck has its key attacker ready, in goldfish games (one chunk).
  consistency
}

enum SimulationJobStatus {
  queued
  running
  done
  failed
  cancelled
}

enum SimulationChunkStatus {
  queued
  leased
  done
  failed
  cancelled
}

/// Implementation status of every engine card, per engine revision (uploaded by the worker from `engine-cli status`).
model EngineCard {
  engineRev String  @map("engine_rev")
  engineId  String  @map("engine_id")
  name      String
  status    String
  complete  Boolean

  @@id([engineRev, engineId])
  @@map("engine_cards")
}

model WorkerNode {
  id             String    @id
  name           String
  engineRev      String?   @map("engine_rev")
  cliVersion     String?   @map("cli_version")
  cores          Int       @default(1)
  version        String?
  /// What its engine can do (`engine-cli version` features), reported from worker 0.2.6 on; empty before.
  engineFeatures String[]  @default([]) @map("engine_features")
  /// Phase 42: how its engine plays (`gamesRev`; 1 for engine-cli 0.3.3 on before it said it, 0 before that).
  gamesRev       Int?      @map("games_rev")
  /// Not claiming until then (worker 0.3.4: results lost in a row), and why; cleared by its next claim.
  pausedUntil    DateTime? @map("paused_until") @db.Timestamptz(3)
  pauseReason    String?   @map("pause_reason")
  /// The pause episode began then (until it delivers a result again): one alert and one push per episode.
  pausedSince    DateTime? @map("paused_since") @db.Timestamptz(3)
  /// `process.platform` it runs on (android, win32, linux), from worker 0.3.5.
  platform       String?
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("worker_nodes")
}

/// The exact deck the engine played: frozen when a job is queued (PLAN §4).
model DeckSnapshot {
  id           Int      @id @default(autoincrement())
  /// Hash of `deckgym_text`: two snapshots of the same list share it.
  key          String
  label        String
  /// deck_revision | tournament_list | text | lab
  sourceType   String   @map("source_type")
  /// Deck revision id, tournament list key…
  sourceId     String?  @map("source_id")
  deckId       Int?     @map("deck_id")
  deckgymText  String   @map("deckgym_text")
  energies     String[]
  /// declared | chosen
  energySource String   @map("energy_source")
  /// [{ cardId, playedAs, engineId, count }]
  cards        Json
  /// [{ kind, message, … }]; empty = simulable
  problems     Json     @default("[]")
  simulable    Boolean
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([key])
  @@index([deckId])
  @@map("deck_snapshots")
}

model SimulationJob {
  id           Int                 @id @default(autoincrement())
  kind         SimulationKind
  status       SimulationJobStatus @default(queued)
  priority     Int                 @default(0)
  label        String
  /// { sideA: snapshotIds, sideB: snapshotIds, bothOrders, lab? } or the optimize payload
  params       Json
  engineRev    String              @map("engine_rev")
  players      String[]
  gamesPerPair Int                 @map("games_per_pair")
  baseSeed     BigInt              @map("base_seed")
  /// Threads per chunk the worker should use (null = what the worker has configured).
  cores        Int?
  replaySample Int                 @default(2) @map("replay_sample")
  totalGames   Int                 @map("total_games")
  /// Phase 42: how its games are played (the engine's `gamesRev`), fixed by its first result; null until then.
  gamesRev     Int?                @map("games_rev")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt    DateTime?           @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?           @map("finished_at") @db.Timestamptz(3)
  /// Hidden from the list (its results still count: comparison, consistency, laboratorio).
  archivedAt   DateTime?           @map("archived_at") @db.Timestamptz(3)
  error        String?
  chunks       SimulationChunk[]

  @@index([status, createdAt])
  @@map("simulation_jobs")
}

model SimulationChunk {
  id          Int                   @id @default(autoincrement())
  jobId       Int                   @map("job_id")
  job         SimulationJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  idx         Int
  snapshotAId Int?                  @map("snapshot_a_id")
  snapshotBId Int?                  @map("snapshot_b_id")
  games       Int
  firstGame   Int                   @default(0) @map("first_game")
  seed        BigInt
  status      SimulationChunkStatus @default(queued)
  attempt     Int                   @default(0)
  /// Times a worker sent it back without spending an attempt (a lost result.json, worker 0.3.4), and which workers.
  returns     Int                   @default(0)
  returnedBy  String[]              @default([]) @map("returned_by")
  leaseUntil  DateTime?             @map("lease_until") @db.Timestamptz(3)
  workerId    String?               @map("worker_id")
  /// When the worker that holds it now took it (phase 42: its pace; `startedAt` is the first lease).
  leasedAt    DateTime?             @map("leased_at") @db.Timestamptz(3)
  /// Phase 42, «repetir los últimos»: a faster worker playing the same chunk near the end of its job, and until when;
  /// the first result counts.
  copyWorker  String?               @map("shadow_worker_id")
  copyUntil   DateTime?             @map("shadow_lease_until") @db.Timestamptz(3)
  /// When the copy started (it becomes `leasedAt` if the copy wins or goes on as the holder).
  copySince   DateTime?             @map("shadow_leased_at") @db.Timestamptz(3)
  gamesDone   Int                   @default(0) @map("games_done")
  winsA       Int?                  @map("wins_a")
  winsB       Int?                  @map("wins_b")
  ties        Int?
  turns       BigInt?
  durationMs  Int?                  @map("duration_ms")
  engineRev   String?               @map("engine_rev")
  /// engine-cli version of the worker that played it: a result is reused only by the same version (phase 42).
  cliVersion  String?               @map("cli_version")
  /// Copied from this chunk (the exact cache, phase 42): no worker played it.
  cachedFrom  Int?                  @map("cached_from_id")
  /// optimize: { combinations: [...] }
  extra       Json?
  error       String?
  startedAt   DateTime?             @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?             @map("finished_at") @db.Timestamptz(3)
  replays     SimulationReplay[]

  @@unique([jobId, idx])
  @@index([status, leaseUntil])
  @@index([snapshotAId])
  @@index([snapshotBId])
  @@index([seed])
  @@map("simulation_chunks")
}

model SimulationReplay {
  id        Int             @id @default(autoincrement())
  chunkId   Int             @map("chunk_id")
  chunk     SimulationChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  gameId    String          @map("game_id")
  gameIndex Int             @map("game_index")
  seed      String
  /// a | b | tie
  winner    String
  dataGz    Bytes           @map("data_gz")
  sizeBytes Int             @map("size_bytes")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([chunkId, gameId])
  @@map("simulation_replays")
}

// ---------------------------------------------------------------------------------------------------------------
// Playing against a bot (Fase 8)
// ---------------------------------------------------------------------------------------------------------------

/// T-015: who plays the engine's side of a game against the bot.
enum LiveGameRunner {
  /// A worker (engine-cli on a PC, the phone…) claims it.
  worker
  /// The owner's open game page, with the WebAssembly engine; it never goes to a worker (R-003).
  browser
}

enum LiveGameStatus {
  /// Waiting for a worker.
  queued
  /// The engine plays: the bot's turn, or the owner's choice on its way to the engine.
  running
  /// The owner's turn: a decision is pending.
  waiting
  done
  abandoned
  failed
  /// Phase 42: a new deckgym or games revision came while it was being played: it cannot go on the same way.
  engine_changed
}

/// A game of the owner against a bot: the worker on the PC runs `engine-cli play` and relays each decision. The game
/// is fully determined by its seed and the owner's choices, so a worker that restarts rebuilds it from them.
model LiveGame {
  id              Int            @id @default(autoincrement())
  status          LiveGameStatus @default(queued)
  humanSnapshotId Int            @map("human_snapshot_id")
  botSnapshotId   Int            @map("bot_snapshot_id")
  /// The decks' labels when the game started: a restored game (backup) has no snapshots.
  humanLabel      String         @default("") @map("human_label")
  rivalLabel      String         @default("") @map("rival_label")
  /// Bot code (e2, r…).
  bot             String
  seed            BigInt
  engineRev       String         @map("engine_rev")
  /// Phase 42: how the engine that played it plays (`gamesRev`, set by the first worker that took it).
  gamesRev        Int?           @map("games_rev")
  /// T-015: «browser» games are run by the owner's open page (WebAssembly) and never claimed by a worker.
  runner          LiveGameRunner @default(worker)
  /// T-015: a browser game's engine build (the manifest's `build`): a page with another one cannot go on with it.
  engineBuild     String?        @map("engine_build")
  workerId        String?        @map("worker_id")
  leaseUntil      DateTime?      @map("lease_until") @db.Timestamptz(3)
  /// The owner's choice at each decision, in order.
  choices         Int[]
  /// The pending decision: { ply, turn, state, actions }.
  decision        Json?
  /// Every action so far, as the engine reported it.
  log             Json           @default("[]")
  /// Modo entrenador (Fase 20): the engine scores every option of each decision.
  coach           Boolean        @default(false)
  /// One review per owner choice (`CoachReview` of @tcg/domain).
  coachLog        Json           @default("[]") @map("coach_log")
  /// Fase 22: times the owner went back to an earlier decision («deshacer»).
  undos           Int            @default(0)
  /// you | bot | tie
  winner          String?
  turns           Int?
  finalState      Json?          @map("final_state")
  replayGz        Bytes?         @map("replay_gz")
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)

  @@index([status])
  @@map("live_games")
}

/// Fase 12: the owner's notes on how to play against a rival, by its opponent key («mega blaziken ex»).
model RivalNote {
  /// opponentKey of the label: case, accents and punctuation do not matter.
  key         String   @id
  label       String
  /// Limitless archetype it was written from, when there was one.
  archetypeId String?  @map("archetype_id")
  text        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("rival_notes")
}

/// Fase 16: an in-game event with deck rules typed by the owner (types, no ex, rarities, expansions, banned cards).
model Event {
  id        Int       @id @default(autoincrement())
  name      String
  startsOn  DateTime? @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  /// EventRules (packages/domain/src/events/rules.ts).
  rules     Json
  notes     String    @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("events")
}

/// Fase 18: a device subscribed to Web Push (the owner's phone, the PC…).
model PushSubscription {
  id            Int       @id @default(autoincrement())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String    @default("") @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  failures      Int       @default(0)

  @@map("push_subscriptions")
}

/// Fase 24: «situaciones para resolver» — the owner's attempts at a moment of a finished game with the coach (the
/// situations themselves come from the game's replay). Practice data: not in the backup.
/// Fase 30: an answer to a calculation exercise (the question is rebuilt from kind, deck and seed).
model DrillAttempt {
  id        Int      @id @default(autoincrement())
  /// draw | ko
  kind      String
  deckId    Int?     @map("deck_id")
  seed      BigInt
  correct   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("drill_attempts")
}

model PuzzleAttempt {
  gameId      Int       @map("game_id")
  /// Index of the step in the game's replay.
  step        Int
  attempts    Int       @default(0)
  /// The latest attempt was «Como el entrenador» or «Casi igual».
  solved      Boolean   @default(false)
  lastVerdict String?   @map("last_verdict")
  lastAt      DateTime? @map("last_at") @db.Timestamptz(3)

  @@id([gameId, step])
  @@map("puzzle_attempts")
}
