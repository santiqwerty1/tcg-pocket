{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/test/fixtures",
      "!refs",
      "!docs",
      "!**/public",
      "!Boveda",
      "!.posta",
      "!.claude",
      "!engine/games-rev.json",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**", "!apps/web/e2e/**"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    }
  ]
}
