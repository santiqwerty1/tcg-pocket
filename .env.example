# Copy to .env (never committed). Production values live in `fly secrets`.
DATABASE_URL=postgresql://tcg:tcg@127.0.0.1:5433/tcg
# Test database (vitest e2e); same server, separate database.
TEST_DATABASE_URL=postgresql://tcg:tcg@127.0.0.1:5433/tcg_test
# 32+ random bytes, base64. Used to sign/encrypt session material and the TOTP secret at rest.
# Prisma resuelve `localhost` a ::1 y Docker en Windows no responde ahí: usar 127.0.0.1.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxxxxxx
# Bootstrap credentials for the single user (used once by `pnpm -F @tcg/api owner:init`).
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me
PORT=3000
NODE_ENV=development
# Colección pública: configurar la clave anon del frontend del tracker (sin valor por defecto).
# Ver docs/OPERACION.md; friend_id y automática se guardan en ajustes de la app.
# TRACKER_COLLECTION_URL=https://vcwloujmsjuacqpwthee.supabase.co
# TRACKER_COLLECTION_ANON_KEY=public-frontend-anon-key
# Copia diaria de seguridad en backup_blobs (04:00 hora de Buenos Aires); por defecto solo en produccion.
# BACKUP_CRON=true
# Costo de argon2id para hashes nuevos (por defecto el minimo de OWASP: 19 MiB, 2 pasadas, 1 hilo).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
