# Copy to .env (never committed). Production values live in `fly secrets`.
DATABASE_URL=postgresql://tcg:tcg@localhost:5433/tcg
# Test database (vitest e2e); same server, separate database.
TEST_DATABASE_URL=postgresql://tcg:tcg@localhost:5433/tcg_test
# 32+ random bytes, base64. Used to sign/encrypt session material and the TOTP secret at rest.
SESSION_SECRET=change-me
# Bootstrap credentials for the single user (used once by `pnpm -F @tcg/api owner:init`).
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me
PORT=3000
NODE_ENV=development
