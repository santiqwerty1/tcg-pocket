{
  "name": "tcg-pocket",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fixtures:extract": "node scripts/extract-fixtures.mjs",
    "viewer:build": "node scripts/build-viewer.mjs",
    "deploy:fly": "node scripts/deploy.mjs",
    "deploy:check": "node scripts/deploy.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  }
}
